# FastVLM Server Configuration

# === Настройки сервера ===
FASTVLM_HOST=127.0.0.1
FASTVLM_PORT=3001

# === Настройки многопоточности (waitress) ===
# Количество потоков для обработки запросов (рекомендуется 4-8 для GPU моделей)
FASTVLM_THREADS=8
# Максимальное количество соединений в очереди (backlog)
FASTVLM_CONNECTION_LIMIT=1024
# Таймаут соединения в секундах
FASTVLM_CONNECTION_TIMEOUT=60

# === Настройки модели FastVLM ===
FASTVLM_MODEL=1.5b
MAX_NEW_TOKENS=4096
TEMPERATURE=0.1
DO_SAMPLE=true
TOP_P=0.95
REPETITION_PENALTY=1.15

# === Дополнительные параметры для качества ===
NUM_BEAMS=3
EARLY_STOPPING=true
LENGTH_PENALTY=1.0
NO_REPEAT_NGRAM_SIZE=3

# === Настройки производительности ===
MAX_IMAGE_SIZE=4096
BATCH_SIZE=1

# === Настройки логирования ===
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# === Gemini API Configuration ===
# Получите API ключ на https://ai.google.dev/gemini-api/docs/quickstart
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=4096
GEMINI_THINKING_BUDGET=0
