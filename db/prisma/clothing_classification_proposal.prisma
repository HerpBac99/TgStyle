// ПРЕДЛОЖЕНИЕ: Классификация одежды для WardrobeItem
// Два уровня: category (верхний уровень) + subtype (детализация)

// ===== ВАРИАНТ РЕКОМЕНДУЕМЫЙ =====

enum ClothingCategory {
  OUTERWEAR   // Верхняя одежда (куртки, пальто, плащи, пуховики)
  INNERWEAR   // Внутренняя одежда (водолазки, свитеры, кардиганы, худи)
  BODYWEAR    // Одежда на тело (рубашки, футболки, топы, блузки)
  FULLBODY    // Цельная одежда (платья, комбинезоны, ромперы, костюмы)
  LEGWEAR     // Одежда на ноги (джинсы, брюки, штаны, шорты, юбки)
  FOOTWEAR    // Обувь (кроссовки, кеды, ботинки, сапоги, туфли)
  HEADWEAR    // Головные уборы (шапки, шляпы, кепки, панамы)
  ACCESSORIES // Аксессуары (сумки, шарфы, перчатки, очки, ремни)
}

model WardrobeItem {
  id         Int               @id @default(autoincrement())
  telegramId BigInt            @map("telegram_id")
  imagePath  String            @map("image_path") @db.VarChar(500)
  
  // КЛАССИФИКАЦИЯ
  category   ClothingCategory  // Основная категория (обязательно)
  subtype    String?           @db.VarChar(100)  // Детализация: "jacket", "coat", "jeans" (опционально)
  
  // АТРИБУТЫ ОТ FASTVLM
  color      String?           @db.VarChar(50)   // Основной цвет
  style      String?           @db.VarChar(100)  // Стиль: casual, formal, sport, etc
  material   String?           @db.VarChar(100)  // Материал: cotton, denim, leather, etc
  pattern    String?           @db.VarChar(100)  // Узор: plain, striped, checked, etc
  
  // ПОЛЬЗОВАТЕЛЬСКИЕ ДАННЫЕ
  name       String?           @db.VarChar(255)  // Название от пользователя
  tags       String[]                             // Теги от пользователя
  
  // МЕТАДАННЫЕ
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  
  user       User              @relation(fields: [telegramId], references: [telegramId], onDelete: Cascade)

  @@index([telegramId], map: "idx_wardrobe_telegram_id")
  @@index([category], map: "idx_wardrobe_category")
  @@index([subtype], map: "idx_wardrobe_subtype")
  @@index([createdAt(sort: Desc)], map: "idx_wardrobe_created_at")
  @@map("wardrobe_items")
}

