generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int            @id @default(autoincrement())
  telegramId           BigInt         @unique
  firstName            String
  lastName             String?
  username             String?
  avatarUrl            String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  isActive             Boolean        @default(true)
  analysesCount        Int            @default(3)
  subscriptionType     String         @default("free")
  subscriptionEndDate  DateTime?
  totalAnalyses        Int            @default(0)
  weeklyResetDate      DateTime       @default(now())
  capsules             Capsule[]
  capsuleLikes         CapsuleLike[]
  comments             Comment[]
  historyItems         HistoryItem[]
  relatedNotifications Notification[] @relation("NotificationRelatedUser")
  notifications        Notification[]
  ratings              Rating[]
  wardrobe_items       WardrobeItem[]

  @@map("users")
}

model HistoryItem {
  id                Int            @id @default(autoincrement())
  userId            Int
  photoData         String?        // Deprecated: legacy base64 data
  photoPath         String?        @map("photo_path") @db.VarChar(500)  // NEW: path to file
  analysisText      String?
  technicalAnalysis String?
  isPublic          Boolean        @default(false)  // Теперь false по умолчанию, true только после sharing
  shareId           String?        @unique @map("share_id") @db.VarChar(100)  // NEW: для shared анализов
  likesCount        Int            @default(0) @map("likes_count")  // Денормализованный счетчик лайков
  viewsCount        Int            @default(0) @map("views_count")  // Денормализованный счетчик просмотров
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  comments          Comment[]
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications     Notification[]
  ratings           Rating[]

  @@index([shareId])
  @@map("history_items")
}

model Rating {
  id            Int         @id @default(autoincrement())
  userId        Int
  historyItemId Int
  ratingType    String
  createdAt     DateTime    @default(now())
  historyItem   HistoryItem @relation(fields: [historyItemId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, historyItemId])
  @@map("ratings")
}

model Comment {
  id              Int            @id @default(autoincrement())
  userId          Int
  historyItemId   Int
  content         String
  parentCommentId Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  isDeleted       Boolean        @default(false)
  historyItem     HistoryItem    @relation(fields: [historyItemId], references: [id], onDelete: Cascade)
  parentComment   Comment?       @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[]      @relation("CommentReplies")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications   Notification[]

  @@map("comments")
}

model Notification {
  id            Int          @id @default(autoincrement())
  userId        Int
  type          String
  message       String
  relatedUserId Int?
  historyItemId Int?
  commentId     Int?
  isRead        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  comment       Comment?     @relation(fields: [commentId], references: [id])
  historyItem   HistoryItem? @relation(fields: [historyItemId], references: [id])
  relatedUser   User?        @relation("NotificationRelatedUser", fields: [relatedUserId], references: [id])
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum ClothingCategory {
  OUTERWEAR   // Верхняя одежда (куртки, пальто, плащи, бомберы, жакеты, безрукавки)
  INNERWEAR   // Свитеры (кофты, водолазки, свитеры, кардиганы, худи)
  BODYWEAR    // Футболки и рубашки (футболки, рубашки, блузки, топы, майки, поло, лонгсливы)
  FULLBODY    // Цельная одежда (платья, костюмы, комбинезоны, спортивные костюмы, комплекты)
  LEGWEAR     // Штаны (штаны, брюки, джинсы, шорты, бриджы, спортивные штаны)
  FOOTWEAR    // Обувь (кроссовки, ботинки, туфли, сапоги, сандалии)
  HEADWEAR    // Головные уборы (шапки, шляпы, кепки, панамы, шарфы)
  ACCESSORIES // Аксессуары (сумки, ремни, украшения, очки, перчатки)
}

model WardrobeItem {
  id         Int               @id @default(autoincrement())
  telegramId BigInt            @map("telegram_id")
  imagePath  String            @map("image_path") @db.VarChar(500)

  // Классификация
  category   ClothingCategory? // Основная категория
  subtype    String?           @db.VarChar(100)  // Детализация: jacket, coat, jeans

  // Атрибуты от FastVLM
  color      String?           @db.VarChar(50)   // Основной цвет
  style      String?           @db.VarChar(100)  // Стиль: casual, formal, sport
  material   String?           @db.VarChar(100)  // Материал: cotton, denim, leather
  pattern    String?           @db.VarChar(100)  // Узор: plain, striped, checked
  fit        String?           @db.VarChar(100)  // Посадка/фит: slim, regular, loose
  season     String?           @db.VarChar(50)   // Сезон: spring, summer, autumn, winter, all-season
  description String?          @db.VarChar(500)  // Описание предмета одежды

  // Пользовательские данные
  name       String?           @db.VarChar(255)  // Название от пользователя
  tags       String[]                             // Теги

  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  user       User              @relation(fields: [telegramId], references: [telegramId], onDelete: Cascade, onUpdate: NoAction, map: "fk_wardrobe_user")

  // Связь с капсулами (многие ко многим)
  capsules   Capsule[]

  @@index([category], map: "idx_wardrobe_category")
  @@index([subtype], map: "idx_wardrobe_subtype")
  @@index([createdAt(sort: Desc)], map: "idx_wardrobe_created_at")
  @@index([telegramId], map: "idx_wardrobe_telegram_id")
  @@map("wardrobe_items")
}

model Capsule {
  id          Int      @id @default(autoincrement())
  telegramId  BigInt   @map("telegram_id")
  user        User     @relation(fields: [telegramId], references: [telegramId], onDelete: Cascade, onUpdate: NoAction, map: "fk_capsule_user")

  name        String?  @db.VarChar(255)  // Название капсулы
  description String?  @db.VarChar(500)  // Описание капсулы

  canvasData  Json     // Данные canvas: wardrobe_items[], items[], canvas{}
  thumbnailPath String? @map("thumbnail_path") // Путь к thumbnail изображению
  metadata    Json?    // Метаданные: source, recommendations, season, reasoning

  analysis    String?  @db.Text         // Анализ от LLM стилиста
  analysisDate DateTime? @map("analysis_date")

  isPublic    Boolean  @default(false) @map("is_public")  // Можно ли делиться капсулой
  shareId     String?  @unique @map("share_id") @db.VarChar(100)  // Для shared капсул
  likesCount  Int      @default(0) @map("likes_count")  // Денормализованный счетчик лайков
  viewsCount  Int      @default(0) @map("views_count")  // Денормализованный счетчик просмотров

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  items       WardrobeItem[]
  capsuleLikes CapsuleLike[]

  @@index([telegramId], map: "idx_capsule_telegram_id")
  @@index([createdAt(sort: Desc)], map: "idx_capsule_created_at")
  @@index([isPublic], map: "idx_capsule_is_public")
  @@index([shareId], map: "idx_capsule_share_id")
  @@map("capsules")
}

model CapsuleLike {
  id        Int      @id @default(autoincrement())
  userId    Int
  capsuleId Int
  createdAt DateTime @default(now())
  capsule   Capsule  @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capsuleId])
  @@map("capsule_likes")
}
