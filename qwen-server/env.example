# Qwen2.5-VL Server Configuration

# Server Settings
QWEN_HOST=127.0.0.1
QWEN_PORT=3002

# Model Selection (3b, 7b, 72b)
QWEN_MODEL=3b

# Generation Settings
MAX_NEW_TOKENS=512
TEMPERATURE=0.1
DO_SAMPLE=false
TOP_P=0.8

# Performance Settings
MAX_IMAGE_SIZE=2048
BATCH_SIZE=1

# Logging Settings
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Gemini API (optional, for stylist responses)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=4096
GEMINI_THINKING_BUDGET=0
